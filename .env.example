# =============================================================================
# Estimateur Kerplus — variables d'environnement
# Copier ce fichier vers .env puis renseigner les valeurs.
# NE JAMAIS committer de secret réel.
# =============================================================================

# --- Base de données ---------------------------------------------------------
DATABASE_URL="postgresql://kerplus:kerplus@localhost:5432/kerplus?schema=public"
# Base dédiée aux tests d'intégration (jamais la base de développement).
TEST_DATABASE_URL="postgresql://kerplus:kerplus@localhost:5432/kerplus_test?schema=public"

# --- Application -------------------------------------------------------------
# URL publique canonique (sans slash final).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"
TZ="Africa/Dakar"

# --- Sécurité / sessions -----------------------------------------------------
# Secret de signature des sessions admin (min. 32 caractères).
# Générer avec : openssl rand -base64 48
AUTH_SECRET="changeme-generate-a-random-48-bytes-secret"
# Durée de session admin en secondes (défaut : 8 h).
SESSION_MAX_AGE="28800"

# --- Compte administrateur initial (utilisé par `npm run db:seed`) -----------
# Si ADMIN_PASSWORD est vide, aucun compte n'est créé par le seed :
# utiliser alors `npm run admin:create`.
ADMIN_EMAIL="admin@kerplus.sn"
ADMIN_NAME="Administrateur Kerplus"
ADMIN_PASSWORD=""

# --- Paiement ----------------------------------------------------------------
# Fournisseur actif : "wave_link" (redirection vers un lien Wave, confirmation
# manuelle par l'administrateur) ou "wave_api" (API Wave officielle).
# wave_api reste inopérant tant que WAVE_API_KEY / WAVE_API_BASE_URL /
# WAVE_WEBHOOK_SECRET ne sont pas renseignés avec des valeurs officielles.
PAYMENT_PROVIDER="wave_link"

# Mode lien de paiement
WAVE_PAYMENT_URL="https://wave.com/pay/kerplus"

# Mode API (à renseigner uniquement avec la documentation officielle Wave)
WAVE_API_BASE_URL=""
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""

# Prix du rapport Premium en FCFA entier (surchargé par le paramètre en base
# `premium_report_price_xof` s'il est défini).
PREMIUM_REPORT_PRICE_XOF="50000"

# --- Email -------------------------------------------------------------------
# "preview" : aucun envoi réel, les messages sont écrits dans storage/emails
# "smtp"    : envoi via le serveur SMTP configuré ci-dessous
EMAIL_PROVIDER="preview"
EMAIL_FROM="Kerplus <contact@kerplus.sn>"
EMAIL_REPLY_TO="contact@kerplus.sn"
# Copie interne des notifications de commande (optionnel).
EMAIL_INTERNAL_NOTIFICATION="contact@kerplus.sn"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Stockage des rapports ---------------------------------------------------
# Répertoire hors `public/` : les PDF ne sont jamais servis en statique.
REPORT_STORAGE_DIR="./storage/reports"
# Durée de validité d'un lien de téléchargement, en heures.
REPORT_DOWNLOAD_TTL_HOURS="720"
# Taille maximale d'un PDF importé, en octets (défaut 15 Mo).
REPORT_MAX_UPLOAD_BYTES="15728640"

# --- Anti-spam ---------------------------------------------------------------
RATE_LIMIT_ENABLED="true"
# CAPTCHA optionnel (laisser vide pour désactiver). Fournisseur : "turnstile".
CAPTCHA_PROVIDER=""
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""

# --- Analytics ---------------------------------------------------------------
# "none" | "console" | "ga4" | "posthog" | "meta"
NEXT_PUBLIC_ANALYTICS_PROVIDER="none"
NEXT_PUBLIC_ANALYTICS_ID=""
NEXT_PUBLIC_POSTHOG_HOST=""

# --- Build -------------------------------------------------------------------
# Mettre à "true" pour produire une image Docker autonome (output standalone).
NEXT_OUTPUT_STANDALONE="false"
